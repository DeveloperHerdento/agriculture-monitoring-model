# Every environment variable the code reads, with a comment and a dummy value (HGS-STD 5.3).
# Copy to .env and fill in real values. Never commit .env.

# Library (src/agriculture_monitoring_model/palm.py): folder with the frozen SIAK_AOI01 geojson files
# plantation_boundary.geojson, o1_training_aoi01.geojson, output4_management_priority.geojson
PALM_DATA_DIR=/path/to/agriculture-monitoring-web/backend/data/geojson/palm_oil

# Library (gee.init_ee, called lazily by every palm/paddy runner) and notebooks (PROPOSAL; they still hardcode it):
# Google Earth Engine / Cloud project ID
GEE_PROJECT=your-gee-project-id
# Library: path to a service-account JSON key; empty = use `earthengine authenticate` user credentials
GEE_KEY_FILE=

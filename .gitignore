# Rasters and temp files the notebooks write next to themselves (e.g. temp_dw.tif, Raster_VHI_*.tif)
*.tif
*.tiff
temp_dw*/
cache_*/

# Archives and OS junk
*.zip
*.rar
.DS_Store
Thumbs.db

